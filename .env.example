# Скопируй этот файл в backend/.env и заполни значения

# Токен бота — получить у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFabcdefABCDEF1234567890abcdef

# URL твоего приложения на Railway (Railway выдаёт после деплоя)
BACKEND_URL=https://your-app-name.railway.app

# URL мини-приложения (тот же домен + /app/)
MINI_APP_URL=https://your-app-name.railway.app/app/

# База данных — Railway подставляет автоматически при добавлении PostgreSQL
# Локально оставь пустым — будет использоваться SQLite
DATABASE_URL=sqlite:///./dusha.db

# Секретный ключ — придумай любую случайную строку
SECRET_KEY=замени-на-случайную-строку-из-32-символов
